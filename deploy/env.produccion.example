# Plantilla del .env para el servidor de pruebas AlmaLinux.
# instalar.sh genera /opt/resp_project/.env automáticamente a partir de
# esto (con SECRET_KEY generada y DB_PASSWORD que usted haya definido);
# se deja aquí solo como referencia de qué valores quedan escritos.

DB_NAME=resp_db
DB_USER=resp_user
DB_PASSWORD=__REEMPLAZAR__
DB_HOST=localhost
DB_PORT=5440

SECRET_KEY=__GENERADA_AUTOMATICAMENTE__
DEBUG=False
ALLOWED_HOSTS=__IP_DEL_SERVIDOR__
