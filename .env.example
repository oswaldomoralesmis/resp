# Copiar como .env y ajustar valores
DB_NAME=resp_db
DB_USER=resp_user
DB_PASSWORD=resp_password
DB_HOST=localhost
DB_PORT=5432

# Opcionales — si no se definen aquí, se usan los valores de desarrollo
# actuales (ver resp_project/settings.py). En un servidor de pruebas o
# producción SÍ deben definirse los tres (ver deploy/GUIA_DESPLIEGUE.md):
# SECRET_KEY=genera-una-clave-unica-y-larga-para-este-ambiente
# DEBUG=False
# ALLOWED_HOSTS=ip.o.dominio.del.servidor

# Correo para el link de "recuperar contraseña" (usuarios/registration).
# Sin esto, los correos solo se imprimen en consola/log — útil para probar,
# pero no llegan a ninguna bandeja de entrada real. Para que sí lleguen,
# descomente y complete con un SMTP real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.dominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-responder@tabasco.gob.mx
# EMAIL_HOST_PASSWORD=clave-del-correo
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=RESP Tabasco <no-responder@tabasco.gob.mx>
